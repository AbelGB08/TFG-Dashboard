# This property is used by the clients to connect to IceStorm.
Proxies.TopicManager = "IceStorm/TopicManager:default -p 9999"

# Topic prefix used for publications. Keep empty to share RobotStatusPub.
Proxies.RobotStatusPubPrefix = ""

# DS18B20 devices (ls /sys/bus/w1/devices/)
Sensors.root = "/sys/bus/w1/devices"
Sensors.base = "28-3ce104571023"
Sensors.chimenea = "28-3ce104571b69"
Sensors.exterior = "28-3ce10457c7cf"
Sensors.bandeja = "28-3ce10457e22d"

# DS18B20 conversion can take up to 750 ms; two seconds is safe.
Period.Compute = 2000
Period.Emergency = 500

Ice.Warn.Connections = "0"
Ice.Trace.Network = "0"
Ice.Trace.Protocol = "0"
Ice.MessageSizeMax = "20004800"
